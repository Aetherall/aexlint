+package main
+
+import (
+	"bytes"
+	"encoding/binary"
+	stdjson "encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"slices"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/go-json-experiment/json"
+	"github.com/microsoft/typescript-go/shim/bundled"
+	"github.com/microsoft/typescript-go/shim/core"
+	"github.com/microsoft/typescript-go/shim/tsoptions"
+	"github.com/microsoft/typescript-go/shim/tspath"
+	"github.com/microsoft/typescript-go/shim/vfs/cachedvfs"
+	"github.com/microsoft/typescript-go/shim/vfs/osvfs"
+	"github.com/typescript-eslint/tsgolint/internal/linter"
+	"github.com/typescript-eslint/tsgolint/internal/utils"
+)
+
+type serveResult struct {
+	Status int     `json:"status"`
+	Signal *string `json:"signal"`
+	Error  *string `json:"error"`
+	Stderr string  `json:"stderr"`
+}
+
+// runServe answers one headless payload per request frame from a single process, so that
+// parsed source files stay in the process-wide cache across requests. Frames are a four-byte
+// little-endian length followed by the bytes. Once both streams are open, a "ready" frame is
+// written. Each response is a JSON result frame followed by the headless output frame. The loop
+// ends when the request stream is closed.
+//
+// A whole-program request naming prefetch_roots asks for the other projects under those roots to
+// be linted with the same rules while no request is waiting, so that the requests for their files
+// are answered from what is already computed. The process exits as soon as the request stream is
+// closed, whatever is being prefetched.
+func runServe(args []string) int {
+	if len(args) != 2 {
+		fmt.Fprintln(os.Stderr, "usage: serve <request-fifo> <response-fifo>")
+		return 1
+	}
+	requests, err := os.OpenFile(args[0], os.O_RDONLY, 0)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "error opening requests: %v\n", err)
+		return 1
+	}
+	defer requests.Close()
+	responses, err := os.OpenFile(args[1], os.O_RDWR, 0)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "error opening responses: %v\n", err)
+		return 1
+	}
+	defer responses.Close()
+	if writeServeFrame(responses, []byte("ready")) != nil {
+		return 1
+	}
+	var prefetching atomic.Bool
+	var closed atomic.Bool
+	frames := make(chan []byte)
+	failed := make(chan error, 1)
+	go func() {
+		for {
+			payload, err := readServeFrame(requests)
+			if err != nil {
+				closed.Store(true)
+				if prefetching.Load() {
+					os.Exit(0)
+				}
+				failed <- err
+				close(frames)
+				return
+			}
+			frames <- payload
+		}
+	}()
+	answers := &prefetched{}
+	for {
+		var payload []byte
+		open := true
+		if answers.waiting() {
+			select {
+			case payload, open = <-frames:
+			default:
+				prefetching.Store(true)
+				if closed.Load() {
+					answers.cache.save()
+					return 0
+				}
+				answers.next()
+				prefetching.Store(false)
+				continue
+			}
+		} else {
+			payload, open = <-frames
+		}
+		if !open {
+			if err := <-failed; !errors.Is(err, io.EOF) && !errors.Is(err, io.ErrUnexpectedEOF) {
+				fmt.Fprintf(os.Stderr, "error reading request: %v\n", err)
+				return 1
+			}
+			answers.cache.save()
+			return 0
+		}
+		output, status := answers.answer(payload)
+		result, err := json.Marshal(serveResult{Status: status})
+		if err != nil {
+			return 1
+		}
+		if writeServeFrame(responses, result) != nil || writeServeFrame(responses, output) != nil {
+			return 1
+		}
+	}
+}
+
+type served struct {
+	output []byte
+	status int
+}
+
+// prefetched holds the answers to the whole-program requests sharing one set of rules, by the file each covers, and
+// one file of each project still to prefetch.
+type prefetched struct {
+	key     string
+	fields  map[string]stdjson.RawMessage
+	rules   stdjson.RawMessage
+	answers map[string]served
+	pending []string
+	cache   *runCache
+}
+
+type serveConfig struct {
+	FilePaths []string           `json:"file_paths"`
+	Rules     stdjson.RawMessage `json:"rules"`
+}
+
+func (p *prefetched) waiting() bool {
+	return len(p.pending) > 0
+}
+
+// answer runs payload, or returns what an earlier run covering its file answered. Only a request for one file's whole
+// program as it is on disk can be answered so.
+func (p *prefetched) answer(payload []byte) ([]byte, int) {
+	fields := map[string]stdjson.RawMessage{}
+	configs := []serveConfig{}
+	if stdjson.Unmarshal(payload, &fields) != nil || stdjson.Unmarshal(fields["configs"], &configs) != nil {
+		return serveHeadless(payload)
+	}
+	roots := []string{}
+	named := stdjson.Unmarshal(fields["prefetch_roots"], &roots) == nil
+	delete(fields, "prefetch_roots")
+	directory := ""
+	stdjson.Unmarshal(fields["cache_dir"], &directory)
+	delete(fields, "cache_dir")
+	_, overridden := fields["source_overrides"]
+	if string(fields["whole_programs"]) != "true" || overridden || len(configs) != 1 || len(configs[0].FilePaths) != 1 {
+		stripped, err := stdjson.Marshal(fields)
+		if err != nil {
+			return serveHeadless(payload)
+		}
+		return serveHeadless(stripped)
+	}
+	file := configs[0].FilePaths[0]
+	delete(fields, "configs")
+	rest, _ := stdjson.Marshal(fields)
+	if key := string(rest) + string(configs[0].Rules); p.answers == nil || key != p.key {
+		p.key, p.fields, p.rules, p.answers, p.pending = key, fields, configs[0].Rules, map[string]served{}, nil
+		p.cache = nil
+		if directory != "" {
+			if p.cache = openCache(directory, key); p.cache != nil {
+				p.answers = p.cache.load()
+			}
+		}
+		if named {
+			p.pending = projectFiles(roots)
+		}
+	}
+	if found, ok := p.answers[tspath.NormalizeSlashes(file)]; ok {
+		return found.output, found.status
+	}
+	return p.run(file)
+}
+
+// next prefetches the first pending project no answer covers yet.
+func (p *prefetched) next() {
+	for len(p.pending) > 0 {
+		file := p.pending[0]
+		p.pending = p.pending[1:]
+		if _, ok := p.answers[file]; !ok {
+			p.run(file)
+			return
+		}
+	}
+}
+
+func (p *prefetched) run(file string) ([]byte, int) {
+	fields := map[string]stdjson.RawMessage{}
+	for name, value := range p.fields {
+		fields[name] = value
+	}
+	configs, err := stdjson.Marshal([]serveConfig{{FilePaths: []string{file}, Rules: p.rules}})
+	if err != nil {
+		return nil, 1
+	}
+	fields["configs"] = configs
+	payload, err := stdjson.Marshal(fields)
+	if err != nil {
+		return nil, 1
+	}
+	recorded := []linter.ProgramInputs{}
+	if p.cache != nil {
+		onProgramInputs = func(inputs linter.ProgramInputs) { recorded = append(recorded, inputs) }
+	}
+	started := time.Now()
+	output, status := serveHeadless(payload)
+	onProgramInputs = nil
+	if status == 0 {
+		for _, covered := range coveredFiles(output) {
+			p.answers[covered] = served{output, status}
+		}
+		if len(recorded) > 0 {
+			p.cache.store(file, output, recorded, started)
+		}
+	}
+	return output, status
+}
+
+// coveredFiles lists the files a headless output answers for: those of the programs it linted and those it matched to
+// no program.
+func coveredFiles(output []byte) []string {
+	files := []string{}
+	for len(output) >= 5 {
+		size := int(binary.LittleEndian.Uint32(output[:4]))
+		kind := headlessMessageType(output[4])
+		if len(output) < 5+size {
+			break
+		}
+		if kind == headlessMessageTypeProgramFiles || kind == headlessMessageTypeUnmatchedFiles {
+			var message headlessProgramFilesPayload
+			if json.Unmarshal(output[5:5+size], &message) == nil {
+				files = append(files, message.Files...)
+			}
+		}
+		output = output[5+size:]
+	}
+	return files
+}
+
+// projectFiles returns one source file of each tsconfig.json under the current directory whose directory is under one
+// of roots or contains it, largest project first, so that the longest program starts earliest.
+func projectFiles(roots []string) []string {
+	cwd, err := os.Getwd()
+	if err != nil {
+		return nil
+	}
+	cwd = tspath.NormalizeSlashes(cwd)
+	within := func(path string, directory string) bool {
+		return path == directory || strings.HasPrefix(path, strings.TrimSuffix(directory, "/")+"/")
+	}
+	fs := bundled.WrapFS(cachedvfs.From(osvfs.FS()))
+	host := utils.NewCachedFSCompilerHost(cwd, fs, bundled.LibPath(), nil, nil)
+	type project struct {
+		file  string
+		files int
+	}
+	projects := []project{}
+	var walk func(directory string)
+	walk = func(directory string) {
+		entries := fs.GetAccessibleEntries(directory)
+		wanted := slices.ContainsFunc(roots, func(root string) bool {
+			root = tspath.NormalizeSlashes(root)
+			return within(directory, root) || within(root, directory)
+		})
+		if wanted && slices.Contains(entries.Files, "tsconfig.json") {
+			parsed, diagnostics := tsoptions.GetParsedCommandLineOfConfigFile(tspath.CombinePaths(directory, "tsconfig.json"), &core.CompilerOptions{}, nil, host, nil)
+			if len(diagnostics) == 0 && parsed != nil && len(parsed.Errors) == 0 {
+				names := parsed.FileNames()
+				if i := slices.IndexFunc(names, func(name string) bool { return !tspath.IsDeclarationFileName(name) }); i >= 0 {
+					projects = append(projects, project{tspath.NormalizeSlashes(names[i]), len(names)})
+				}
+			}
+		}
+		for _, name := range entries.Directories {
+			if name != "node_modules" && !strings.HasPrefix(name, ".") {
+				walk(tspath.CombinePaths(directory, name))
+			}
+		}
+	}
+	walk(cwd)
+	slices.SortStableFunc(projects, func(a, b project) int { return b.files - a.files })
+	files := []string{}
+	for _, found := range projects {
+		files = append(files, found.file)
+	}
+	return files
+}
+
+func serveHeadless(payload []byte) ([]byte, int) {
+	stdin, stdout, commandLine := os.Stdin, os.Stdout, flag.CommandLine
+	inputReader, inputWriter, err := os.Pipe()
+	if err != nil {
+		return nil, 1
+	}
+	outputReader, outputWriter, err := os.Pipe()
+	if err != nil {
+		return nil, 1
+	}
+	go func() {
+		inputWriter.Write(payload)
+		inputWriter.Close()
+	}()
+	var output bytes.Buffer
+	copied := make(chan struct{})
+	go func() {
+		io.Copy(&output, outputReader)
+		close(copied)
+	}()
+	os.Stdin, os.Stdout = inputReader, outputWriter
+	flag.CommandLine = flag.NewFlagSet(os.Args[0], flag.ContinueOnError)
+	status := runHeadless(nil)
+	os.Stdin, os.Stdout, flag.CommandLine = stdin, stdout, commandLine
+	outputWriter.Close()
+	<-copied
+	inputReader.Close()
+	outputReader.Close()
+	return output.Bytes(), status
+}
+
+func readServeFrame(r io.Reader) ([]byte, error) {
+	var header [4]byte
+	if _, err := io.ReadFull(r, header[:]); err != nil {
+		return nil, err
+	}
+	payload := make([]byte, binary.LittleEndian.Uint32(header[:]))
+	_, err := io.ReadFull(r, payload)
+	return payload, err
+}
+
+func writeServeFrame(w io.Writer, payload []byte) error {
+	var header [4]byte
+	binary.LittleEndian.PutUint32(header[:], uint32(len(payload)))
+	if _, err := w.Write(header[:]); err != nil {
+		return err
+	}
+	_, err := w.Write(payload)
+	return err
+}
