+package main
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/gob"
+	"encoding/hex"
+	"io"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"slices"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/microsoft/typescript-go/shim/bundled"
+	"github.com/microsoft/typescript-go/shim/core"
+	"github.com/microsoft/typescript-go/shim/tsoptions"
+	"github.com/microsoft/typescript-go/shim/tspath"
+	"github.com/microsoft/typescript-go/shim/vfs/cachedvfs"
+	"github.com/microsoft/typescript-go/shim/vfs/osvfs"
+	"github.com/typescript-eslint/tsgolint/internal/linter"
+	"github.com/typescript-eslint/tsgolint/internal/utils"
+)
+
+// onProgramInputs receives what each whole-program run reads while a run is being recorded.
+var onProgramInputs func(inputs linter.ProgramInputs)
+
+// unusedFor is how long an answer is kept without being used.
+const unusedFor = 7 * 24 * time.Hour
+
+// settled is how long before a run a file must have been written for its timestamp to tell it from one written
+// during the run, given how coarsely file systems stamp times.
+const settled = 50 * time.Millisecond
+
+// variants is how many answers are kept for one project, for the checkouts and branches that differ in it.
+const variants = 8
+
+// saveEvery is how often the hashes of the files read so far are written while answers are being computed.
+const saveEvery = 2 * time.Second
+
+type cachedInput struct {
+	Path string
+	Hash [sha256.Size]byte
+}
+
+// cachedRun is the answer to one whole-program request with everything it depends on: the files its programs read
+// and the root files each of its configs named. Paths under the working directory are relative to it, in the answer
+// too, so that another checkout of the same files reuses it.
+type cachedRun struct {
+	Output []byte
+	Inputs []cachedInput
+	Roots  map[string][sha256.Size]byte
+}
+
+type fileState struct {
+	Size     int64
+	Modified int64
+	Hash     [sha256.Size]byte
+}
+
+// runCache keeps whole-program answers on disk between runs of one backend build, set of project configs and set of
+// rules, wherever the checkout is. An answer is reused while every file its programs read has the same content and
+// every config still names the same root files. A file that would be read only once it exists is not tracked unless
+// a config names it. The hash of each file is remembered per working directory with its size and modification time.
+type runCache struct {
+	directory string
+	cwd       string
+	index     string
+	mu        sync.RWMutex
+	states    map[string]fileState
+	changed   atomic.Bool
+	saved     time.Time
+	roots     sync.Map
+	packages  sync.Map
+}
+
+// portable tells whether directory is written the same way by every JSON encoder, so that it can be found in an
+// answer and replaced.
+func portable(directory string) bool {
+	return !strings.ContainsFunc(directory, func(r rune) bool {
+		return r < 0x20 || r > 0x7e || strings.ContainsRune("\"\\<>&", r)
+	})
+}
+
+func openCache(directory string, key string) *runCache {
+	cwd, err := os.Getwd()
+	if err != nil {
+		return nil
+	}
+	hash := sha256.New()
+	executable, err := os.Executable()
+	if err != nil {
+		return nil
+	}
+	binary, err := os.Open(executable)
+	if err != nil {
+		return nil
+	}
+	_, err = io.Copy(hash, binary)
+	binary.Close()
+	if err != nil {
+		return nil
+	}
+	hash.Write([]byte("\x00" + key + "\x00"))
+	if !portable(cwd) {
+		hash.Write([]byte(cwd + "\x00"))
+	}
+	cache := &runCache{cwd: tspath.NormalizeSlashes(cwd), states: map[string]fileState{}, saved: time.Now()}
+	configs := []string{}
+	filepath.WalkDir(cwd, func(path string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			return nil
+		}
+		name := entry.Name()
+		if entry.IsDir() {
+			if path != cwd && (name == "node_modules" || strings.HasPrefix(name, ".")) {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if strings.HasSuffix(name, ".json") && (strings.HasPrefix(name, "tsconfig") || strings.HasPrefix(name, "jsconfig")) {
+			configs = append(configs, path)
+		}
+		return nil
+	})
+	for _, config := range configs {
+		content, err := os.ReadFile(config)
+		if err != nil {
+			return nil
+		}
+		hash.Write([]byte(cache.relative(tspath.NormalizeSlashes(config)) + "\x00"))
+		hash.Write(content)
+		hash.Write([]byte{0})
+	}
+	cache.directory = filepath.Join(directory, hex.EncodeToString(hash.Sum(nil))[:32])
+	if os.MkdirAll(cache.directory, 0o755) != nil {
+		return nil
+	}
+	now := time.Now()
+	os.Chtimes(cache.directory, now, now)
+	others, _ := os.ReadDir(directory)
+	for _, other := range others {
+		if info, err := other.Info(); err == nil && other.IsDir() && now.Sub(info.ModTime()) > unusedFor {
+			os.RemoveAll(filepath.Join(directory, other.Name()))
+		}
+	}
+	place := sha256.Sum256([]byte(cwd))
+	cache.index = filepath.Join(cache.directory, hex.EncodeToString(place[:])[:32]+".stat")
+	if content, err := os.ReadFile(cache.index); err == nil {
+		if gob.NewDecoder(bytes.NewReader(content)).Decode(&cache.states) != nil {
+			cache.states = map[string]fileState{}
+		}
+	}
+	return cache
+}
+
+func (c *runCache) relative(path string) string {
+	if rest, ok := strings.CutPrefix(path, c.cwd+"/"); ok {
+		return rest
+	}
+	return path
+}
+
+func (c *runCache) absolute(path string) string {
+	if filepath.IsAbs(path) {
+		return path
+	}
+	return c.cwd + "/" + path
+}
+
+// moved rewrites the working directory in every message of a headless output, from one spelling to another.
+func moved(output []byte, from string, to string) []byte {
+	result := make([]byte, 0, len(output))
+	for len(output) >= 5 {
+		size := int(binary.LittleEndian.Uint32(output[:4]))
+		if len(output) < 5+size {
+			break
+		}
+		message := output[5 : 5+size]
+		for _, end := range []string{"/", "\""} {
+			message = bytes.ReplaceAll(message, []byte(from+end), []byte(to+end))
+		}
+		result = binary.LittleEndian.AppendUint32(result, uint32(len(message)))
+		result = append(result, output[4])
+		result = append(result, message...)
+		output = output[5+size:]
+	}
+	return append(result, output...)
+}
+
+// elsewhere stands for the working directory in a stored answer; no JSON text holds this byte.
+const elsewhere = "\x00"
+
+func (c *runCache) rootsOf(config string) [sha256.Size]byte {
+	once, _ := c.roots.LoadOrStore(config, sync.OnceValue(func() [sha256.Size]byte {
+		path := c.absolute(config)
+		host := utils.NewCachedFSCompilerHost(tspath.GetDirectoryPath(path), bundled.WrapFS(cachedvfs.From(osvfs.FS())), bundled.LibPath(), nil, nil)
+		parsed, diagnostics := tsoptions.GetParsedCommandLineOfConfigFile(path, &core.CompilerOptions{}, nil, host, nil)
+		if len(diagnostics) > 0 || parsed == nil {
+			return [sha256.Size]byte{}
+		}
+		return c.rootsHash(parsed.FileNames())
+	}))
+	return once.(func() [sha256.Size]byte)()
+}
+
+func (c *runCache) rootsHash(files []string) [sha256.Size]byte {
+	hash := sha256.New()
+	for _, file := range files {
+		hash.Write([]byte(c.relative(file) + "\x00"))
+	}
+	return [sha256.Size]byte(hash.Sum(nil))
+}
+
+// hashOf returns the content hash of a file and when it was last written. The hash is remembered with the file's
+// size and modification time once the file has been left alone long enough for those to identify its content.
+func (c *runCache) hashOf(path string) (hash [sha256.Size]byte, modified time.Time, ok bool) {
+	info, err := os.Stat(c.absolute(path))
+	if err != nil {
+		return hash, modified, false
+	}
+	modified = info.ModTime()
+	c.mu.RLock()
+	state, known := c.states[path]
+	c.mu.RUnlock()
+	if known && state.Size == info.Size() && state.Modified == modified.UnixNano() {
+		return state.Hash, modified, true
+	}
+	content, err := os.ReadFile(c.absolute(path))
+	if err != nil || int64(len(content)) != info.Size() {
+		return hash, modified, false
+	}
+	hash = sha256.Sum256(content)
+	if time.Since(modified) > settled {
+		c.mu.Lock()
+		c.states[path] = fileState{info.Size(), modified.UnixNano(), hash}
+		c.mu.Unlock()
+		c.changed.Store(true)
+	}
+	return hash, modified, true
+}
+
+// save writes the remembered file hashes of this working directory.
+func (c *runCache) save() {
+	if c == nil || !c.changed.Swap(false) {
+		return
+	}
+	c.saved = time.Now()
+	var encoded bytes.Buffer
+	c.mu.RLock()
+	err := gob.NewEncoder(&encoded).Encode(c.states)
+	c.mu.RUnlock()
+	if err == nil {
+		c.write(c.index, encoded.Bytes())
+	}
+}
+
+func (c *runCache) write(path string, content []byte) {
+	temporary, err := os.CreateTemp(c.directory, "new-*")
+	if err != nil {
+		return
+	}
+	_, err = temporary.Write(content)
+	if temporary.Close() != nil || err != nil || os.Rename(temporary.Name(), path) != nil {
+		os.Remove(temporary.Name())
+	}
+}
+
+func (c *runCache) current(run *cachedRun) bool {
+	for config, roots := range run.Roots {
+		if c.rootsOf(config) != roots {
+			return false
+		}
+	}
+	stale := make(chan bool, 32)
+	chunk := (len(run.Inputs) + 31) / 32
+	parts := 0
+	for start := 0; start < len(run.Inputs); start += chunk {
+		parts++
+		go func(inputs []cachedInput) {
+			stale <- slices.ContainsFunc(inputs, func(input cachedInput) bool {
+				hash, _, ok := c.hashOf(input.Path)
+				return !ok || hash != input.Hash
+			})
+		}(run.Inputs[start:min(start+chunk, len(run.Inputs))])
+	}
+	valid := true
+	for range parts {
+		if <-stale {
+			valid = false
+		}
+	}
+	return valid
+}
+
+// load returns the stored answers that are current here, by the file each covers. Of the answers stored for one
+// project, the most recently used current one is taken; those beyond the newest few or unused for too long are
+// removed.
+func (c *runCache) load() map[string]served {
+	entries, err := os.ReadDir(c.directory)
+	if err != nil {
+		return nil
+	}
+	type stored struct {
+		path string
+		used time.Time
+	}
+	projects := map[string][]stored{}
+	now := time.Now()
+	for _, entry := range entries {
+		info, err := entry.Info()
+		if err != nil {
+			continue
+		}
+		path := filepath.Join(c.directory, entry.Name())
+		project, _, isRun := strings.Cut(strings.TrimSuffix(entry.Name(), ".run"), "-")
+		if !strings.HasSuffix(entry.Name(), ".run") || !isRun {
+			if now.Sub(info.ModTime()) > unusedFor {
+				os.Remove(path)
+			}
+			continue
+		}
+		projects[project] = append(projects[project], stored{path, info.ModTime()})
+	}
+	var mu sync.Mutex
+	var wg sync.WaitGroup
+	answers := map[string]served{}
+	for _, runs := range projects {
+		wg.Go(func() {
+			sort.Slice(runs, func(i, j int) bool { return runs[i].used.After(runs[j].used) })
+			found := false
+			for i, stored := range runs {
+				if i >= variants || now.Sub(stored.used) > unusedFor {
+					os.Remove(stored.path)
+					continue
+				}
+				if found {
+					continue
+				}
+				content, err := os.ReadFile(stored.path)
+				run := cachedRun{}
+				if err != nil || gob.NewDecoder(bytes.NewReader(content)).Decode(&run) != nil {
+					os.Remove(stored.path)
+					continue
+				}
+				if !c.current(&run) {
+					continue
+				}
+				found = true
+				os.Chtimes(stored.path, now, now)
+				output := moved(run.Output, elsewhere, c.cwd)
+				covered := coveredFiles(output)
+				mu.Lock()
+				for _, file := range covered {
+					answers[file] = served{output, 0}
+				}
+				mu.Unlock()
+			}
+		})
+	}
+	wg.Wait()
+	c.save()
+	return answers
+}
+
+func (c *runCache) packageOf(directory string) string {
+	if found, ok := c.packages.Load(directory); ok {
+		return found.(string)
+	}
+	found := filepath.Join(directory, "package.json")
+	if _, err := os.Stat(found); err != nil {
+		found = ""
+		if parent := filepath.Dir(directory); parent != directory {
+			found = c.packageOf(parent)
+		}
+	}
+	c.packages.Store(directory, found)
+	return found
+}
+
+// store records the answer to the request for seed, unless one of its inputs may have changed since the run started.
+func (c *runCache) store(seed string, output []byte, recorded []linter.ProgramInputs, started time.Time) {
+	run := cachedRun{Output: moved(output, c.cwd, elsewhere), Roots: map[string][sha256.Size]byte{}}
+	paths := map[string]bool{}
+	for _, inputs := range recorded {
+		for config, roots := range inputs.Roots {
+			run.Roots[c.relative(config)] = c.rootsHash(roots)
+		}
+		for _, file := range inputs.Files {
+			if strings.HasPrefix(file, "bundled:") {
+				continue
+			}
+			paths[c.relative(file)] = true
+			if manifest := c.packageOf(filepath.Dir(file)); manifest != "" {
+				paths[c.relative(manifest)] = true
+			}
+		}
+	}
+	for path := range paths {
+		run.Inputs = append(run.Inputs, cachedInput{Path: path})
+	}
+	slices.SortFunc(run.Inputs, func(a, b cachedInput) int { return strings.Compare(a.Path, b.Path) })
+	var wg sync.WaitGroup
+	var fresh atomic.Bool
+	fresh.Store(true)
+	chunk := max((len(run.Inputs)+31)/32, 1)
+	for start := 0; start < len(run.Inputs); start += chunk {
+		inputs := run.Inputs[start:min(start+chunk, len(run.Inputs))]
+		wg.Go(func() {
+			for i := range inputs {
+				hash, modified, ok := c.hashOf(inputs[i].Path)
+				if !ok || !modified.Before(started.Add(-settled)) {
+					fresh.Store(false)
+					return
+				}
+				inputs[i].Hash = hash
+			}
+		})
+	}
+	wg.Wait()
+	if time.Since(c.saved) > saveEvery {
+		c.save()
+	}
+	if !fresh.Load() {
+		return
+	}
+	var encoded bytes.Buffer
+	if gob.NewEncoder(&encoded).Encode(run) != nil {
+		return
+	}
+	project := sha256.Sum256([]byte(c.relative(seed)))
+	content := sha256.New()
+	for _, input := range run.Inputs {
+		content.Write([]byte(input.Path + "\x00"))
+		content.Write(input.Hash[:])
+	}
+	name := hex.EncodeToString(project[:])[:32] + "-" + hex.EncodeToString(content.Sum(nil))[:32] + ".run"
+	c.write(filepath.Join(c.directory, name), encoded.Bytes())
+}
