{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./src/index.ts"],
  "categories": { "correctness": "off" },
  "rules": {
    "aexlint/prefer-domain-predicate": "warn",
    "aexlint/max-call-assembly": ["warn", { "maxWidth": 60, "maxReferences": 3 }],
    "aexlint/max-held-context": ["warn", { "max": 3 }],
    "aexlint/no-else-if": "warn",
    "aexlint/no-multiline-condition": "warn"
  },
  "ignorePatterns": ["node_modules", "dist", ".native", ".pi", ".devenv", ".direnv"]
}
